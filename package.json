{
  "name": "api-truth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "analyzers/*",
    "connectors/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:env:up": "node scripts/test-environment.ts up",
    "test:env:ready": "node scripts/test-environment.ts ready",
    "test:env:down": "node scripts/test-environment.ts down",
    "test:integration": "node scripts/test-environment.ts ready && vitest run --config vitest.integration.config.ts --maxWorkers=2",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": "24.6.0",
    "npm": "11.5.1"
  },
  "devDependencies": {
    "@types/node": "24.6.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.1",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "pg": "8.23.0"
  }
}
